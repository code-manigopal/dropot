{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/auth/(.*)",    "dest": "api/auth.py" },
    { "src": "/api/drive/(.*)",   "dest": "api/drive.py" },
    { "src": "/api/groups/(.*)",  "dest": "api/groups.py" },
    { "src": "/api/notify/(.*)",  "dest": "api/notify.py" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "https://code-manigopal.github.io" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    }
  ]
}
